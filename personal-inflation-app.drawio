        <mxCell id="cq23WIchvqrzxKAR0oyZ-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=18;" value="How It Works?" vertex="1">
