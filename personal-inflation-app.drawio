        <mxCell id="u2aHrqAUeqZqV6IxxZCq-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="PERSONAL INFLATION APP" vertex="1">
          <mxGeometry height="30" width="180" x="70" y="45" as="geometry" />
        </mxCell>
        <mxCell id="u2aHrqAUeqZqV6IxxZCq-4" parent="1" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Web_UI-2597/Menu-2-1472.svg;labelPerimeter=1;" value="" vertex="1">
